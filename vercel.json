{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/places-reviews",
      "destination": "/api/google-reviews"
    },
    {
      "source": "/api/whatsapp/trigger-devotee-message",
      "destination": "/api/whatsapp-trigger"
    },
    {
      "source": "/api/leads/:id",
      "destination": "/api/leads?id=:id"
    },
    {
      "source": "/api/blogs/:slug",
      "destination": "/api/blogs?slug=:slug"
    },
    {
      "source": "/api/news/:id",
      "destination": "/api/news?id=:id"
    },
    {
      "source": "/api/pilgrims/:id",
      "destination": "/api/pilgrims?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
