export const HeroSlider = memo(({ onOpenInquiry, onOpenAiConsultant, onSelectDestination }: HeroSliderProps) => {
  const { language, t } = useLanguage();
  const [currentIndex, setCurrentIndex] = useState(0);
  const [direction, setDirection] = useState(1);
  const [isPaused, setIsPaused] = useState(false);
  const [isInView, setIsInView] = useState(true);
  const sectionRef = useRef<HTMLElement>(null);
  const [touchStartX, setTouchStartX] = useState<number | null>(null);

  // Pause slider completely when scrolled out of view to save CPU and reduce background refresh
  useEffect(() => {
    const el = sectionRef.current;
    if (!el || typeof IntersectionObserver === "undefined") return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        setIsInView(entry.isIntersecting);
      },
      { threshold: 0.1 }
    );
    observer.observe(el);
    return () => observer.disconnect();
  }, []);

  // Preload only the immediate next slide images sequentially to preserve bandwidth
  useEffect(() => {
    const preloadNext = () => {
      const nextSlide = BANNER_SLIDES[(currentIndex + 1) % BANNER_SLIDES.length];
      if (nextSlide) {
        const img1 = new Image();
        img1.src = nextSlide.mountainBg;
        const img2 = new Image();
        img2.src = nextSlide.devoteeImg;
      }
    };

    if ('requestIdleCallback' in window) {
      const handle = (window as any).requestIdleCallback(preloadNext, { timeout: 2500 });
      return () => (window as any).cancelIdleCallback?.(handle);
    } else {
      const timer = setTimeout(preloadNext, 1200);
      return () => clearTimeout(timer);
    }
  }, [currentIndex]);

  // Keyboard navigation for desktop users
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      if (activeTag === 'input' || activeTag === 'textarea' || (document.activeElement as HTMLElement)?.isContentEditable) {
        return;
      }
      if (e.key === 'ArrowLeft') {
        handlePrev();
      } else if (e.key === 'ArrowRight') {
        handleNext();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  // Auto slide timer (relaxed to 9.5s to reduce refresh rate and pause when off-screen or tab hidden)
  useEffect(() => {
    if (isPaused || !isInView) return;
    const timer = setInterval(() => {
      if (document.hidden) return;
      setDirection(1);
      setCurrentIndex(prev => (prev + 1) % BANNER_SLIDES.length);
    }, 9500);
    return () => clearInterval(timer);
  }, [isPaused, isInView]);

  const currentSlide = BANNER_SLIDES[currentIndex];
  const langKey = (['en', 'hi', 'gu', 'mr', 'bn'].includes(language) ? language : 'en') as Language;

  const currentTagline = currentSlide.tagline[langKey] || currentSlide.tagline.en;
  const currentTitle = currentSlide.title[langKey] || currentSlide.title.en;
  const currentSubtitle = currentSlide.subtitle[langKey] || currentSlide.subtitle.en;
  const currentBullets = currentSlide.bullets[langKey] || currentSlide.bullets.en;
  const currentButtonText = currentSlide.buttonText[langKey] || currentSlide.buttonText.en;

  const handleNext = () => {
    setDirection(1);
    setCurrentIndex(prev => (prev + 1) % BANNER_SLIDES.length);
  };

  const handlePrev = () => {
    setDirection(-1);
    setCurrentIndex(prev => (prev - 1 + BANNER_SLIDES.length) % BANNER_SLIDES.length);
  };

  const handleSelectSlide = (idx: number) => {
    if (idx === currentIndex) return;
    setDirection(idx > currentIndex ? 1 : -1);
    setCurrentIndex(idx);
  };

  const handleTouchStart = (e: React.TouchEvent) => {
    setTouchStartX(e.touches[0].clientX);
  };

  const handleTouchEnd = (e: React.TouchEvent) => {
    if (touchStartX === null) return;
    const deltaX = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(deltaX) > 45) {
      if (deltaX < 0) {
        handleNext();
      } else {
        handlePrev();
      }
    }
    setTouchStartX(null);
  };

  return (
    <section 
      id="hero"
      ref={sectionRef}
      onMouseEnter={() => setIsPaused(true)}
      onMouseLeave={() => setIsPaused(false)}
      onTouchStart={handleTouchStart}
      onTouchEnd={handleTouchEnd}
      className="relative w-full pt-36 sm:pt-40 lg:pt-44 pb-8 px-3 sm:px-6 lg:px-8 bg-[#F4F6FA] select-none"
    >
      <div className="max-w-6xl mx-auto space-y-5">
        
        {/* Main Curved Hero Banner Card */}
        <div 
          className="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-blue-400/20 text-white min-h-[490px] sm:min-h-[550px] flex flex-col justify-between p-5 sm:p-8 lg:p-10"
          style={{
            backgroundColor: '#0c1b33',
            backgroundImage: 'radial-gradient(ellipse at 85% 15%, rgba(30, 64, 175, 0.4), transparent 55%), linear-gradient(135deg, #0a1128 0%, #102a43 45%, #1f3a60 100%)'
          }}
        >
          
          {/* Subtle Background Mountain Texture Layer with Crossfade */}
          <div className="absolute inset-0 overflow-hidden pointer-events-none">
            <AnimatePresence mode="sync">
              <motion.div 
                key={currentSlide.mountainBg}
                initial={{ opacity: 0, scale: 1.04 }}
                animate={{ opacity: 0.32, scale: 1 }}
                exit={{ opacity: 0 }}
                transition={{ duration: 0.75, ease: "easeInOut" }}
                className="absolute inset-0 bg-cover bg-center mix-blend-overlay"
                style={{ 
                  backgroundImage: `url(${currentSlide.mountainBg}), url(${currentSlide.blurDataURL || getDestinationBlurPlaceholder(currentSlide.destinationSlug || currentSlide.id)})` 
                }}
              />
            </AnimatePresence>
          </div>

          {/* Text Contrast Protection Gradient Layer */}
          <div 
            className="absolute inset-0 pointer-events-none z-0"
            style={{
              background: 'linear-gradient(90deg, rgba(6, 12, 22, 0.85) 0%, rgba(9, 18, 33, 0.65) 55%, rgba(13, 24, 43, 0.25) 100%)'
            }}
          />

          {/* Left Arrow Nav Button */}
          <button
            onClick={handlePrev}
            className="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-900/60 hover:bg-[#C91D24] text-white border border-white/20 backdrop-blur-md flex items-center justify-center transition-all shadow-xl cursor-pointer focus:outline-none"
            aria-label="Previous Slide (Left Arrow)"
            title="Previous (Left Arrow)"
          >
            <ChevronLeft size={22} className="stroke-[2.5]" />
          </button>

          {/* Right Arrow Nav Button */}
          <button
            onClick={handleNext}
            className="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-900/60 hover:bg-[#C91D24] text-white border border-white/20 backdrop-blur-md flex items-center justify-center transition-all shadow-xl cursor-pointer focus:outline-none"
            aria-label="Next Slide (Right Arrow)"
            title="Next (Right Arrow)"
          >
            <ChevronRight size={22} className="stroke-[2.5]" />
          </button>

          {/* Content Grid: Left Bullet Checklist + Right Devotee & Peak Visual */}
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center relative z-10 my-auto pl-7 pr-7 sm:pl-10 sm:pr-10">
            
            {/* Left Column: Headline & Bullet Points with Silky Staggered Transition */}
            <div className="lg:col-span-7 min-h-[310px] flex flex-col justify-center">
              <AnimatePresence mode="wait" custom={direction}>
                <motion.div 
                  key={`${currentSlide.id}-${language}`}
                  custom={direction}
                  variants={textContainerVariants}
                  initial="initial"
                  animate="animate"
                  exit="exit"
                  className="space-y-4 text-left will-change-transform"
                >
                  
                  {/* Tagline & Headline */}
                  <motion.div 
                    variants={textItemVariants}
                    custom={direction}
                    className="space-y-2"
                  >
                    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/15 border border-amber-400/30 text-amber-300 text-[11px] font-bold uppercase tracking-wider">
                      <span>{currentTagline}</span>
                    </div>

                    <h1 className="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight uppercase text-white leading-[1.14] drop-shadow-sm">
                      {currentTitle}
                    </h1>
                  </motion.div>

                  {/* Subtitle */}
                  {currentSubtitle && (
                    <p className="text-xs sm:text-sm lg:text-[15px] font-medium text-slate-200 tracking-wide max-w-xl leading-relaxed">
                      {currentSubtitle}
                    </p>
                  )}

                  {/* Clean Bullets List */}
                  <ul className="space-y-2 text-xs sm:text-sm font-normal text-slate-100 leading-relaxed pt-1">
                    {currentBullets.map((bullet, idx) => (
                      <li 
                        key={idx} 
                        className="flex items-start gap-2.5"
                      >
                        <div className="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">
                          ✓
                        </div>
                        <span className="font-medium text-white/95">{bullet}</span>
                      </li>
                    ))}
                  </ul>

                  {/* Action Buttons */}
                  <motion.div 
                    variants={textItemVariants}
                    custom={direction}
                    className="flex flex-wrap items-center gap-3 pt-2 sm:pt-3"
                  >
                    <button
                      onClick={() => onOpenInquiry(currentSlide.title.en)}
                      className="px-6 py-3 rounded-xl bg-[#C91D24] hover:bg-[#a5151c] text-white font-black text-xs uppercase tracking-wider shadow-lg flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
                    >
                      <span>{currentButtonText}</span>
                      <ArrowRight size={14} />
                    </button>

                    {onSelectDestination && (
                      <button
                        onClick={() => onSelectDestination(currentSlide.destinationSlug)}
                        className="px-4 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider backdrop-blur-md border border-white/20 transition-all cursor-pointer flex items-center gap-1.5 shadow-xs"
                      >
                        <MapPin size={13} className="text-amber-300" />
                        <span>{t("common.viewDetails", "View Itinerary")}</span>
                      </button>
                    )}

                    <button
                      onClick={onOpenAiConsultant}
                      className="px-4 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider backdrop-blur-md border border-white/20 transition-all cursor-pointer flex items-center gap-1.5 shadow-xs"
                    >
                      <Sparkles size={13} className="text-amber-300" />
                      <span>{t("nav.aiConcierge", "AI Concierge")}</span>
                    </button>
                  </motion.div>

                </motion.div>
              </AnimatePresence>
            </div>

            {/* Right Column: High-Res Peak & Visual Frame with Synced Transition */}
            <div className="lg:col-span-5 flex justify-center items-center relative min-h-[240px] sm:min-h-[300px]">
              <AnimatePresence mode="wait" custom={direction}>
                <motion.div 
                  key={`${currentSlide.id}-visual`}
                  custom={direction}
                  variants={visualVariants}
                  initial="initial"
                  animate="animate"
                  exit="exit"
                  className="w-full max-w-sm"
                >
                  <div className="relative w-full rounded-2xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950/40 group">
                    <BlurUpImage
                      src={currentSlide.mountainBg}
                      blurDataURL={currentSlide.blurDataURL || getDestinationBlurPlaceholder(currentSlide.destinationSlug || currentSlide.id)}
                      alt={currentTitle}
                      referrerPolicy="no-referrer"
                      loading={currentIndex === 0 ? "eager" : "lazy"}
                      priority={currentIndex === 0}
                      decoding="async"
                      preset="hero"
                      width={640}
                      height={360}
                      fallbackSrc="https://images.unsplash.com/photo-1544735716-392fe2489ffa?auto=format&fit=crop&w=1280&q=80"
                      containerClassName="w-full h-56 sm:h-72"
                      className="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                    />

                    {/* Top Right Floating Badge */}
                    <div className="absolute top-3 right-3 z-10">
                      <span className="px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur-md border border-amber-400/40 text-amber-300 text-[10px] font-bold uppercase tracking-wider shadow-sm flex items-center gap-1">
                        <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
                        <span>2027 Batches Open</span>
                      </span>
                    </div>

                    {/* Gradient Scrim & Captions */}
                    <div className="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent flex flex-col justify-end p-4 text-left pointer-events-none z-10">
                      <span className="text-[10px] uppercase font-black tracking-widest text-amber-300">
                        {language === 'hi' ? 'पावन दर्शन 2027' : language === 'gu' ? 'પવિત્ર દર્શન 2027' : language === 'mr' ? 'पावन दर्शन 2027' : language === 'bn' ? 'পবিত্র দর্শন ২০২৭' : 'Holy Darshan 2027'}
                      </span>
                      <span className="text-sm sm:text-base font-bold text-white leading-tight mt-0.5">
                        {currentSubtitle}
                      </span>
                    </div>
                  </div>
                </motion.div>
              </AnimatePresence>
            </div>

          </div>

          {/* Bottom Slide Indicators with Animated Countdown Progress */}
          <div className="flex items-center justify-center gap-2 pt-3 relative z-10">
            {BANNER_SLIDES.map((slide, idx) => (
              <button
                key={slide.id}
                onClick={() => handleSelectSlide(idx)}
                className={`relative h-2 sm:h-2.5 rounded-full overflow-hidden transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-300 ${
                  idx === currentIndex ? "w-9 sm:w-11 bg-white/30 ring-1 ring-amber-300/50" : "w-2 sm:w-2.5 bg-white/40 hover:bg-white/70"
                }`}
                aria-label={`Go to slide ${idx + 1}: ${slide.id}`}
                aria-current={idx === currentIndex ? "true" : "false"}
              >
                {idx === currentIndex && (
                  <motion.div
                    key={`progress-pill-${currentIndex}-${isPaused}`}
                    initial={{ width: "0%" }}
                    animate={{ width: isPaused ? "0%" : "100%" }}
                    transition={{ duration: isPaused ? 0 : 9.5, ease: "linear" }}
                    className="absolute inset-y-0 left-0 bg-amber-400 rounded-full shadow-[0_0_8px_rgba(245,158,11,0.8)]"
                  />
                )}
              </button>
            ))}
          </div>

        </div>

      </div>
    </section>
  );
});

HeroSlider.displayName = "HeroSlider";