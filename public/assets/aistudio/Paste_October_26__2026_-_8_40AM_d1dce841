const SILKY_EASE = [0.16, 1, 0.3, 1] as const;
const BRISK_EXIT_EASE = [0.32, 0, 0.67, 0] as const;

// Master container orchestrates smooth exit and incoming stagger
const textContainerVariants = {
  initial: (dir: number) => ({
    opacity: 0,
    y: dir > 0 ? 16 : -16,
  }),
  animate: {
    opacity: 1,
    y: 0,
    transition: {
      duration: 0.5,
      ease: SILKY_EASE,
      staggerChildren: 0.05,
      delayChildren: 0.03,
    }
  },
  exit: (dir: number) => ({
    opacity: 0,
    y: dir > 0 ? -12 : 12,
    transition: {
      duration: 0.25,
      ease: BRISK_EXIT_EASE,
    }
  })
};

const textItemVariants = {
  initial: (dir: number) => ({
    opacity: 0,
    y: dir > 0 ? 12 : -12,
  }),
  animate: {
    opacity: 1,
    y: 0,
    transition: {
      duration: 0.45,
      ease: SILKY_EASE,
